# Local development only. Copy to .env if you need to override docker-compose.yml.
# These values are insecure defaults for a workstation. Do not use them anywhere else.

AGENTSHIELD_ENV=development

POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield
POSTGRES_DB=agentshield
POSTGRES_PORT=5432
DATABASE_URL=postgres://agentshield:agentshield@127.0.0.1:5432/agentshield?sslmode=disable
# Production requires the app role created by 0004_app_role_rls.sql:
# DATABASE_URL=postgres://agentshield_app:agentshield-app@127.0.0.1:5432/agentshield?sslmode=disable

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

NATS_URL=nats://127.0.0.1:4222
NATS_PORT=4222

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=agentshield
MINIO_ROOT_PASSWORD=agentshield-dev-only
MINIO_BUCKET=agentshield-evidence
MINIO_USE_SSL=false

CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8080
GATEWAY_HTTP_ADDR=127.0.0.1:8081
INTELLIGENCE_HTTP_ADDR=127.0.0.1:8082
DASHBOARD_PORT=3000
CONTROL_PLANE_URL=http://127.0.0.1:8080
# Optional dashboard bootstrap token. Prefer signing in through /api/session.
# CONTROL_PLANE_TOKEN=

# Used only by the bootstrap command. Not a production credential.
AGENTSHIELD_BOOTSTRAP_EMAIL=owner@example.com
AGENTSHIELD_BOOTSTRAP_PASSWORD=change-me-local-only
AGENTSHIELD_BOOTSTRAP_DISPLAY_NAME=Local Owner
AGENTSHIELD_BOOTSTRAP_ORG_NAME=Local
AGENTSHIELD_BOOTSTRAP_ORG_SLUG=local
